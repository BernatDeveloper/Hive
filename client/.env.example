# Cliente — copia este archivo a client/.env. Vite solo expone las VITE_*.

# URL del servidor Socket.io. Si se omite, el cliente usa http://localhost:3001
VITE_SOCKET_URL=

# Clave pública VAPID — la MISMA que VAPID_PUBLIC_KEY del servidor.
# Necesaria para suscribirse a las notificaciones push.
VITE_VAPID_PUBLIC_KEY=
