# Servidor — copia este archivo a server/.env y rellena los valores.
# El arranque falla si falta alguna VAPID_* (ver server/config/env.js).

# Ruta del fichero SQLite. Por defecto ./hive.db
DB_PATH=

# Puerto HTTP/Socket.io. Por defecto 3001
PORT=

# Modo de ejecución. En 'production' NO se aceptan orígenes de localhost y solo
# valen los de CLIENT_ORIGIN. Pon NODE_ENV=production en el servidor desplegado.
NODE_ENV=

# Origen(es) del cliente en producción, separados por comas (sin ruta; una barra
# final se ignora). OBLIGATORIO al desplegar: ya no se acepta cualquier
# *.vercel.app, solo los que pongas aquí. Ej: https://mi-calendario.com
# En desarrollo (sin NODE_ENV=production) se permite además cualquier puerto de localhost.
CLIENT_ORIGIN=

# Claves Web Push (VAPID) — REQUERIDAS. Generar una sola vez con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o https: de contacto. Ej: mailto:tu@email.com
VAPID_SUBJECT=

# Nivel de log: error | warn | info | debug. Por defecto info
LOG_LEVEL=

# 'true' si hay un proxy inverso delante (Render, Railway, Fly, nginx, Cloudflare…):
# usa X-Forwarded-For como IP del cliente para el límite de intentos de acceso.
# OBLIGATORIO detrás de un proxy: si no, todos los usuarios comparten la IP del
# proxy y el límite de 10 intentos/minuto afecta a TODA la app (el servidor
# avisa en el log si ve X-Forwarded-For con esto desactivado).
# Sin proxy delante déjalo vacío: con 'true' el cliente podría falsear su IP.
TRUST_PROXY=

# Cuántos proxies de confianza hay delante (por defecto 1). Pon 2 si hay, p. ej.,
# un CDN y además el balanceador de la plataforma. Se usa la IP que añadió el
# último proxy de confianza (no la primera entrada, que controla el cliente).
TRUST_PROXY_HOPS=

# Zona horaria del proceso — solo afecta a la hora efectiva (09:00) de los
# recordatorios de eventos de día completo. Los eventos con hora se guardan
# como instante UTC y no dependen de esto. Poner la zona de los miembros de
# la sala, p. ej. Europe/Madrid.
TZ=
