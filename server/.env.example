# Servidor — copia este archivo a server/.env y rellena los valores.
# El arranque falla si falta alguna VAPID_* (ver server/config/env.js).

# Ruta del fichero SQLite. Por defecto ./calendario.db
DB_PATH=

# Puerto HTTP/Socket.io. Por defecto 3001
PORT=

# Origen del cliente en producción (además de localhost y *.vercel.app, que
# se permiten siempre). Ej: https://mi-calendario.com
CLIENT_ORIGIN=

# Claves Web Push (VAPID) — REQUERIDAS. Generar una sola vez con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o https: de contacto. Ej: mailto:tu@email.com
VAPID_SUBJECT=

# Nivel de log: error | warn | info | debug. Por defecto info
LOG_LEVEL=

# Zona horaria del proceso — solo afecta a la hora efectiva (09:00) de los
# recordatorios de eventos de día completo. Los eventos con hora se guardan
# como instante UTC y no dependen de esto. Poner la zona de los miembros de
# la sala, p. ej. Europe/Madrid.
TZ=
